{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "250mb",
        "includeFiles": "{models/**,labels.json,app.py,config.py,inference.py,model_def.py}"
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "api/index.py" }],
  "env": {
    "INFERENCE_ENGINE": "onnx"
  }
}
