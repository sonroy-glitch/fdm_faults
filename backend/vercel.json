{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{models/**,*.py,labels.json}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "env": {
    "INFERENCE_ENGINE": "onnx"
  }
}
